												</xs:annotation>
												<xs:sequence maxOccurs="1">
												<xs:element name="ParticipantTotalBudget">
												<xs:simpleType>
												<xs:annotation>
												<xs:documentation>Participant Cost</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:decimal">
												<xs:minInclusive value="0"/>
												</xs:restriction>
												</xs:simpleType>
												</xs:element>
												<xs:element name="ParticipantEUContribution">
												<xs:simpleType>
												<xs:annotation>
												<xs:documentation>Participant EC Contribution. The beneficiaries are the only participant types having an "EC contribution". It corresponds to the amount allocated to a beneficiary as specified in the grant agreement. The sum of the EC contributions in a project is equal to the grant amount.</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:decimal">
												<xs:minInclusive value="0"/>
												</xs:restriction>
												</xs:simpleType>
												</xs:element>
												<xs:element name="ParticipantNetEUContribution">
												<xs:simpleType>
												<xs:annotation>
												<xs:documentation>"A participant's Net EU financial contribution is the sum of money that the participant receives, deducted by the EU contribution to its linked thirdparty. It considers distribution of the EU financial contribution between direct beneficiaries of the project and other type of participants, notably thirdparty participants.&#xD;
&#xD;
In the eCORDA context, the Net EU financial contributions will be, depending on the participant type:&#xD;
&#xD;
- The Net contribution of a third-party participant is the amount it receives from its linked beneficiary.&#xD;
&#xD;
- The Net contribution of a beneficiary is the difference between its EU financial contribution and the Net contribution of its linked third-party.&#xD;
&#xD;
The sum of the Net EU contributions of all participants in a project is equal to the grant amount."</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:decimal">
												<xs:minInclusive value="0"/>
												</xs:restriction>
												</xs:simpleType>
